{
  "name": "geocoder-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:cases": "tsx scripts/build-cases.ts",
    "compare:nominatim": "tsx scripts/run-comparison.ts --geocoder nominatim",
    "compare:nominatim:test": "tsx scripts/run-comparison.ts --geocoder nominatim --limit 5",
    "compare:photon": "tsx scripts/run-comparison.ts --geocoder photon",
    "compare:photon:test": "tsx scripts/run-comparison.ts --geocoder photon --limit 5",
    "compare:arcgis": "tsx scripts/run-comparison.ts --geocoder arcgis",
    "compare:arcgis:test": "tsx scripts/run-comparison.ts --geocoder arcgis --limit 5",
    "compare:sudir": "tsx scripts/run-comparison.ts --geocoder sudir",
    "compare:sudir:test": "tsx scripts/run-comparison.ts --geocoder sudir --limit 5",
    "compare:all": "npm run compare:nominatim && npm run compare:photon && npm run compare:arcgis && npm run compare:sudir"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "ol": "^10.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.15.0",
    "daisyui": "^5.5.20",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
